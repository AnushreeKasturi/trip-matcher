# Copy this file to .env and fill in your real key.
# Get a key at https://serpapi.com/manage-api-key (free tier: 250 searches/month)
SERPAPI_KEY=your_serpapi_key_here

# Optional: how long cached SerpApi responses are reused before re-fetching
# live prices. Higher = fewer API calls, staler prices. Default 72.
# CACHE_TTL_HOURS=72
